NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2025-08-29
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# Shopify Storefront (required — boot fails without these)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Display currency for the storefront (ISO 4217). Must match the Shopify store's
# currency — the optimistic cart line is seeded from it before Shopify responds.
NEXT_PUBLIC_STORE_CURRENCY=GBP

# AI assistant (optional — /api/chat returns 503 until both are set)
# AI_GATEWAY_API_KEY — get from https://vercel.com/dashboard/ai-gateway
# Only required for local dev; on Vercel deployments OIDC auto-authenticates.
AI_GATEWAY_API_KEY=
SANITY_CONTEXT_MCP_URL=
