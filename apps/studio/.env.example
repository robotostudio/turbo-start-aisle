SANITY_STUDIO_DATASET=dataset
SANITY_STUDIO_PROJECT_ID=project_id
SANITY_STUDIO_TITLE="Turbo Studio"
# Storefront origin the Presentation tool loads in its iframe.
# Set this to the PRODUCTION storefront URL, not localhost. Studio is a static
# build and SANITY_STUDIO_* vars are inlined at build time, so whatever is here
# when you run `sanity deploy` is baked into the deployed bundle — a localhost
# value leaves the live Studio previewing a machine nobody else can reach.
# Local `sanity dev` ignores this and always uses localhost:3000 (see
# getPresentationUrl in utils/helper.ts), so a production value is safe here.
SANITY_STUDIO_PRESENTATION_URL=https://your-storefront.example.com
SANITY_STUDIO_PRODUCTION_HOSTNAME=
SANITY_STUDIO_API_VERSION=

# Shopify Admin API (used by seed scripts)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
